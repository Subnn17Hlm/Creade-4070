[
  {
    "text": "每次出差旅行",
    "start_time": 0.0,
    "end_time": 1.021,
    "duration": 1.021
  },
  {
    "text": "是不是都在为",
    "start_time": 1.021,
    "end_time": 2.041,
    "duration": 1.021
  },
  {
    "text": "带哪个吹风机发愁",
    "start_time": 2.041,
    "end_time": 3.376,
    "duration": 1.334
  },
  {
    "text": "酒店的吹风机",
    "start_time": 3.376,
    "end_time": 4.396,
    "duration": 1.021
  },
  {
    "text": "风小还伤发",
    "start_time": 4.396,
    "end_time": 5.296,
    "duration": 0.9
  },
  {
    "text": "我真的会谢…",
    "start_time": 5.296,
    "end_time": 6.552,
    "duration": 1.256
  },
  {
    "text": "还好被我挖到了这个出差神器",
    "start_time": 6.552,
    "end_time": 8.671,
    "duration": 2.119
  },
  {
    "text": "它折起来就比手机大一点点",
    "start_time": 8.671,
    "end_time": 10.634,
    "duration": 1.962
  },
  {
    "text": "放包里",
    "start_time": 10.634,
    "end_time": 11.534,
    "duration": 0.9
  },
  {
    "text": "行李箱里巨省地方",
    "start_time": 11.534,
    "end_time": 12.868,
    "duration": 1.334
  },
  {
    "text": "别看它小",
    "start_time": 12.868,
    "end_time": 13.768,
    "duration": 0.9
  },
  {
    "text": "11万转的风力可不是盖的",
    "start_time": 13.768,
    "end_time": 15.731,
    "duration": 1.962
  },
  {
    "text": "我这长头发",
    "start_time": 15.731,
    "end_time": 16.631,
    "duration": 0.9
  },
  {
    "text": "几分钟就搞定了",
    "start_time": 16.631,
    "end_time": 17.808,
    "duration": 1.177
  },
  {
    "text": "而且它这个屏显调温我真的超爱",
    "start_time": 17.808,
    "end_time": 20.084,
    "duration": 2.276
  },
  {
    "text": "想要什么温度自己调",
    "start_time": 20.084,
    "end_time": 21.576,
    "duration": 1.491
  },
  {
    "text": "清清楚楚",
    "start_time": 21.576,
    "end_time": 22.476,
    "duration": 0.9
  },
  {
    "text": "经常出门的姐妹",
    "start_time": 22.476,
    "end_time": 23.653,
    "duration": 1.177
  },
  {
    "text": "这个颜值高又强悍的小东西",
    "start_time": 23.653,
    "end_time": 25.616,
    "duration": 1.962
  },
  {
    "text": "必须焊在你的行李箱里",
    "start_time": 25.616,
    "end_time": 27.264,
    "duration": 1.648
  }
]