[
  {
    "text": "姐妹们",
    "start_time": 0.0,
    "end_time": 0.9,
    "duration": 0.9
  },
  {
    "text": "出门旅行最怕什么",
    "start_time": 0.9,
    "end_time": 2.461,
    "duration": 1.561
  },
  {
    "text": "头发毛躁",
    "start_time": 2.461,
    "end_time": 3.361,
    "duration": 0.9
  },
  {
    "text": "吹不干",
    "start_time": 3.361,
    "end_time": 4.261,
    "duration": 0.9
  },
  {
    "text": "酒店的吹风机又老又旧",
    "start_time": 4.261,
    "end_time": 6.204,
    "duration": 1.943
  },
  {
    "text": "吹完头发像稻草一样",
    "start_time": 6.204,
    "end_time": 7.956,
    "duration": 1.752
  },
  {
    "text": "直到我发现了这个便携吹风机",
    "start_time": 7.956,
    "end_time": 10.471,
    "duration": 2.515
  },
  {
    "text": "真的救了我的头发",
    "start_time": 10.471,
    "end_time": 12.032,
    "duration": 1.561
  },
  {
    "text": "它只有巴掌大小",
    "start_time": 12.032,
    "end_time": 13.403,
    "duration": 1.371
  },
  {
    "text": "放进行李箱完全不占地方",
    "start_time": 13.403,
    "end_time": 15.536,
    "duration": 2.133
  },
  {
    "text": "但是风力超级强劲",
    "start_time": 15.536,
    "end_time": 17.097,
    "duration": 1.561
  },
  {
    "text": "11万转高速电机",
    "start_time": 17.097,
    "end_time": 18.659,
    "duration": 1.561
  },
  {
    "text": "吹干速度是普通吹风机的两倍",
    "start_time": 18.659,
    "end_time": 21.173,
    "duration": 2.515
  },
  {
    "text": "最绝的是它的护发功能",
    "start_time": 21.173,
    "end_time": 23.116,
    "duration": 1.943
  },
  {
    "text": "负离子护发",
    "start_time": 23.116,
    "end_time": 24.105,
    "duration": 0.989
  },
  {
    "text": "吹完头发顺滑有光泽",
    "start_time": 24.105,
    "end_time": 25.857,
    "duration": 1.752
  },
  {
    "text": "智能温控系统",
    "start_time": 25.857,
    "end_time": 27.037,
    "duration": 1.18
  },
  {
    "text": "不会烫伤头皮",
    "start_time": 27.037,
    "end_time": 28.217,
    "duration": 1.18
  },
  {
    "text": "也不会让头发过度干燥",
    "start_time": 28.217,
    "end_time": 30.16,
    "duration": 1.943
  },
  {
    "text": "折叠设计超贴心",
    "start_time": 30.16,
    "end_time": 31.531,
    "duration": 1.371
  },
  {
    "text": "单手就能操作",
    "start_time": 31.531,
    "end_time": 32.711,
    "duration": 1.18
  },
  {
    "text": "现在下单还送收纳袋和风嘴套装",
    "start_time": 32.711,
    "end_time": 35.416,
    "duration": 2.705
  },
  {
    "text": "性价比绝了",
    "start_time": 35.416,
    "end_time": 36.405,
    "duration": 0.989
  },
  {
    "text": "经常出差旅行的姐妹",
    "start_time": 36.405,
    "end_time": 38.157,
    "duration": 1.752
  },
  {
    "text": "这个必须安排上",
    "start_time": 38.157,
    "end_time": 39.528,
    "duration": 1.371
  }
]