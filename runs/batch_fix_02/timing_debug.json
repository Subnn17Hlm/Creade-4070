[
  {
    "text": "每次出差旅行",
    "start_time": 0.0,
    "end_time": 1.018,
    "duration": 1.018
  },
  {
    "text": "是不是都在为",
    "start_time": 1.018,
    "end_time": 2.036,
    "duration": 1.018
  },
  {
    "text": "带哪个吹风机发愁",
    "start_time": 2.036,
    "end_time": 3.366,
    "duration": 1.33
  },
  {
    "text": "酒店的吹风机",
    "start_time": 3.366,
    "end_time": 4.384,
    "duration": 1.018
  },
  {
    "text": "风小还伤发",
    "start_time": 4.384,
    "end_time": 5.284,
    "duration": 0.9
  },
  {
    "text": "我真的会谢…",
    "start_time": 5.284,
    "end_time": 6.536,
    "duration": 1.252
  },
  {
    "text": "还好被我挖到了这个出差神器",
    "start_time": 6.536,
    "end_time": 8.648,
    "duration": 2.112
  },
  {
    "text": "它折起来就比手机大一点点",
    "start_time": 8.648,
    "end_time": 10.604,
    "duration": 1.956
  },
  {
    "text": "放包里",
    "start_time": 10.604,
    "end_time": 11.504,
    "duration": 0.9
  },
  {
    "text": "行李箱里巨省地方",
    "start_time": 11.504,
    "end_time": 12.834,
    "duration": 1.33
  },
  {
    "text": "别看它小",
    "start_time": 12.834,
    "end_time": 13.734,
    "duration": 0.9
  },
  {
    "text": "11万转的风力可不是盖的",
    "start_time": 13.734,
    "end_time": 15.69,
    "duration": 1.956
  },
  {
    "text": "我这长头发",
    "start_time": 15.69,
    "end_time": 16.59,
    "duration": 0.9
  },
  {
    "text": "几分钟就搞定了",
    "start_time": 16.59,
    "end_time": 17.764,
    "duration": 1.174
  },
  {
    "text": "而且它这个屏显调温我真的超爱",
    "start_time": 17.764,
    "end_time": 20.032,
    "duration": 2.268
  },
  {
    "text": "想要什么温度自己调",
    "start_time": 20.032,
    "end_time": 21.519,
    "duration": 1.487
  },
  {
    "text": "清清楚楚",
    "start_time": 21.519,
    "end_time": 22.419,
    "duration": 0.9
  },
  {
    "text": "经常出门的姐妹",
    "start_time": 22.419,
    "end_time": 23.593,
    "duration": 1.174
  },
  {
    "text": "这个颜值高又强悍的小东西",
    "start_time": 23.593,
    "end_time": 25.549,
    "duration": 1.956
  },
  {
    "text": "必须焊在你的行李箱里",
    "start_time": 25.549,
    "end_time": 27.192,
    "duration": 1.643
  }
]