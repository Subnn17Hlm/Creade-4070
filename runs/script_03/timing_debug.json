[
  {
    "text": "姐妹们",
    "start_time": 0.0,
    "end_time": 0.9,
    "duration": 0.9
  },
  {
    "text": "出门旅行最怕什么",
    "start_time": 0.9,
    "end_time": 2.533,
    "duration": 1.633
  },
  {
    "text": "头发毛躁",
    "start_time": 2.533,
    "end_time": 3.433,
    "duration": 0.9
  },
  {
    "text": "吹不干",
    "start_time": 3.433,
    "end_time": 4.333,
    "duration": 0.9
  },
  {
    "text": "酒店的吹风机又老又旧",
    "start_time": 4.333,
    "end_time": 6.367,
    "duration": 2.034
  },
  {
    "text": "吹完头发像稻草一样",
    "start_time": 6.367,
    "end_time": 8.2,
    "duration": 1.833
  },
  {
    "text": "直到我发现了这个便携吹风机",
    "start_time": 8.2,
    "end_time": 10.836,
    "duration": 2.635
  },
  {
    "text": "真的救了我的头发",
    "start_time": 10.836,
    "end_time": 12.469,
    "duration": 1.633
  },
  {
    "text": "它只有巴掌大小",
    "start_time": 12.469,
    "end_time": 13.901,
    "duration": 1.433
  },
  {
    "text": "放进行李箱完全不占地方",
    "start_time": 13.901,
    "end_time": 16.136,
    "duration": 2.234
  },
  {
    "text": "但是风力超级强劲",
    "start_time": 16.136,
    "end_time": 17.769,
    "duration": 1.633
  },
  {
    "text": "11万转高速电机",
    "start_time": 17.769,
    "end_time": 19.402,
    "duration": 1.633
  },
  {
    "text": "吹干速度是普通吹风机的两倍",
    "start_time": 19.402,
    "end_time": 22.037,
    "duration": 2.635
  },
  {
    "text": "最绝的是它的护发功能",
    "start_time": 22.037,
    "end_time": 24.071,
    "duration": 2.034
  },
  {
    "text": "负离子护发",
    "start_time": 24.071,
    "end_time": 25.103,
    "duration": 1.032
  },
  {
    "text": "吹完头发顺滑有光泽",
    "start_time": 25.103,
    "end_time": 26.936,
    "duration": 1.833
  },
  {
    "text": "智能温控系统",
    "start_time": 26.936,
    "end_time": 28.168,
    "duration": 1.232
  },
  {
    "text": "不会烫伤头皮",
    "start_time": 28.168,
    "end_time": 29.4,
    "duration": 1.232
  },
  {
    "text": "也不会让头发过度干燥",
    "start_time": 29.4,
    "end_time": 31.434,
    "duration": 2.034
  },
  {
    "text": "折叠设计超贴心",
    "start_time": 31.434,
    "end_time": 32.867,
    "duration": 1.433
  },
  {
    "text": "单手就能操作",
    "start_time": 32.867,
    "end_time": 34.099,
    "duration": 1.232
  },
  {
    "text": "现在下单还送收纳袋和风嘴套装",
    "start_time": 34.099,
    "end_time": 36.934,
    "duration": 2.836
  },
  {
    "text": "性价比绝了",
    "start_time": 36.934,
    "end_time": 37.966,
    "duration": 1.032
  },
  {
    "text": "经常出差旅行的姐妹",
    "start_time": 37.966,
    "end_time": 39.799,
    "duration": 1.833
  },
  {
    "text": "这个必须安排上",
    "start_time": 39.799,
    "end_time": 41.232,
    "duration": 1.433
  }
]