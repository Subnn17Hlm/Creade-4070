[
  {
    "text": "每次出差旅行",
    "start_time": 0.0,
    "end_time": 0.98,
    "duration": 0.98
  },
  {
    "text": "是不是都在为",
    "start_time": 0.98,
    "end_time": 1.96,
    "duration": 0.98
  },
  {
    "text": "带哪个吹风机发愁",
    "start_time": 1.96,
    "end_time": 3.233,
    "duration": 1.273
  },
  {
    "text": "酒店的吹风机",
    "start_time": 3.233,
    "end_time": 4.213,
    "duration": 0.98
  },
  {
    "text": "风小还伤发",
    "start_time": 4.213,
    "end_time": 5.113,
    "duration": 0.9
  },
  {
    "text": "我真的会谢…",
    "start_time": 5.113,
    "end_time": 6.313,
    "duration": 1.2
  },
  {
    "text": "还好被我挖到了这个出差神器",
    "start_time": 6.313,
    "end_time": 8.319,
    "duration": 2.006
  },
  {
    "text": "它折起来就比手机大一点点",
    "start_time": 8.319,
    "end_time": 10.178,
    "duration": 1.859
  },
  {
    "text": "放包里",
    "start_time": 10.178,
    "end_time": 11.078,
    "duration": 0.9
  },
  {
    "text": "行李箱里巨省地方",
    "start_time": 11.078,
    "end_time": 12.351,
    "duration": 1.273
  },
  {
    "text": "别看它小",
    "start_time": 12.351,
    "end_time": 13.251,
    "duration": 0.9
  },
  {
    "text": "11万转的风力可不是盖的",
    "start_time": 13.251,
    "end_time": 15.11,
    "duration": 1.859
  },
  {
    "text": "我这长头发",
    "start_time": 15.11,
    "end_time": 16.01,
    "duration": 0.9
  },
  {
    "text": "几分钟就搞定了",
    "start_time": 16.01,
    "end_time": 17.137,
    "duration": 1.127
  },
  {
    "text": "而且它这个屏显调温我真的超爱",
    "start_time": 17.137,
    "end_time": 19.289,
    "duration": 2.152
  },
  {
    "text": "想要什么温度自己调",
    "start_time": 19.289,
    "end_time": 20.708,
    "duration": 1.42
  },
  {
    "text": "清清楚楚",
    "start_time": 20.708,
    "end_time": 21.608,
    "duration": 0.9
  },
  {
    "text": "经常出门的姐妹",
    "start_time": 21.608,
    "end_time": 22.735,
    "duration": 1.127
  },
  {
    "text": "这个颜值高又强悍的小东西",
    "start_time": 22.735,
    "end_time": 24.594,
    "duration": 1.859
  },
  {
    "text": "必须焊在你的行李箱里",
    "start_time": 24.594,
    "end_time": 26.16,
    "duration": 1.566
  }
]