[
  {
    "text": "姐妹们",
    "start_time": 0.0,
    "end_time": 0.9,
    "duration": 0.9
  },
  {
    "text": "出门旅行最怕什么",
    "start_time": 0.9,
    "end_time": 2.535,
    "duration": 1.635
  },
  {
    "text": "头发毛躁",
    "start_time": 2.535,
    "end_time": 3.435,
    "duration": 0.9
  },
  {
    "text": "吹不干",
    "start_time": 3.435,
    "end_time": 4.335,
    "duration": 0.9
  },
  {
    "text": "酒店的吹风机又老又旧",
    "start_time": 4.335,
    "end_time": 6.372,
    "duration": 2.037
  },
  {
    "text": "吹完头发像稻草一样",
    "start_time": 6.372,
    "end_time": 8.207,
    "duration": 1.836
  },
  {
    "text": "直到我发现了这个便携吹风机",
    "start_time": 8.207,
    "end_time": 10.846,
    "duration": 2.639
  },
  {
    "text": "真的救了我的头发",
    "start_time": 10.846,
    "end_time": 12.481,
    "duration": 1.635
  },
  {
    "text": "它只有巴掌大小",
    "start_time": 12.481,
    "end_time": 13.915,
    "duration": 1.434
  },
  {
    "text": "放进行李箱完全不占地方",
    "start_time": 13.915,
    "end_time": 16.153,
    "duration": 2.237
  },
  {
    "text": "但是风力超级强劲",
    "start_time": 16.153,
    "end_time": 17.788,
    "duration": 1.635
  },
  {
    "text": "11万转高速电机",
    "start_time": 17.788,
    "end_time": 19.423,
    "duration": 1.635
  },
  {
    "text": "吹干速度是普通吹风机的两倍",
    "start_time": 19.423,
    "end_time": 22.061,
    "duration": 2.639
  },
  {
    "text": "最绝的是它的护发功能",
    "start_time": 22.061,
    "end_time": 24.098,
    "duration": 2.037
  },
  {
    "text": "负离子护发",
    "start_time": 24.098,
    "end_time": 25.131,
    "duration": 1.033
  },
  {
    "text": "吹完头发顺滑有光泽",
    "start_time": 25.131,
    "end_time": 26.966,
    "duration": 1.836
  },
  {
    "text": "智能温控系统",
    "start_time": 26.966,
    "end_time": 28.2,
    "duration": 1.234
  },
  {
    "text": "不会烫伤头皮",
    "start_time": 28.2,
    "end_time": 29.433,
    "duration": 1.234
  },
  {
    "text": "也不会让头发过度干燥",
    "start_time": 29.433,
    "end_time": 31.47,
    "duration": 2.037
  },
  {
    "text": "折叠设计超贴心",
    "start_time": 31.47,
    "end_time": 32.904,
    "duration": 1.434
  },
  {
    "text": "单手就能操作",
    "start_time": 32.904,
    "end_time": 34.138,
    "duration": 1.234
  },
  {
    "text": "现在下单还送收纳袋和风嘴套装",
    "start_time": 34.138,
    "end_time": 36.977,
    "duration": 2.84
  },
  {
    "text": "性价比绝了",
    "start_time": 36.977,
    "end_time": 38.01,
    "duration": 1.033
  },
  {
    "text": "经常出差旅行的姐妹",
    "start_time": 38.01,
    "end_time": 39.846,
    "duration": 1.836
  },
  {
    "text": "这个必须安排上",
    "start_time": 39.846,
    "end_time": 41.28,
    "duration": 1.434
  }
]