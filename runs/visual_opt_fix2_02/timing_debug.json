[
  {
    "text": "每次出差旅行",
    "start_time": 0.0,
    "end_time": 1.005,
    "duration": 1.005
  },
  {
    "text": "是不是都在为",
    "start_time": 1.005,
    "end_time": 2.009,
    "duration": 1.005
  },
  {
    "text": "带哪个吹风机发愁",
    "start_time": 2.009,
    "end_time": 3.319,
    "duration": 1.31
  },
  {
    "text": "酒店的吹风机",
    "start_time": 3.319,
    "end_time": 4.324,
    "duration": 1.005
  },
  {
    "text": "风小还伤发",
    "start_time": 4.324,
    "end_time": 5.224,
    "duration": 0.9
  },
  {
    "text": "我真的会谢…",
    "start_time": 5.224,
    "end_time": 6.458,
    "duration": 1.234
  },
  {
    "text": "还好被我挖到了这个出差神器",
    "start_time": 6.458,
    "end_time": 8.533,
    "duration": 2.075
  },
  {
    "text": "它折起来就比手机大一点点",
    "start_time": 8.533,
    "end_time": 10.455,
    "duration": 1.922
  },
  {
    "text": "放包里",
    "start_time": 10.455,
    "end_time": 11.355,
    "duration": 0.9
  },
  {
    "text": "行李箱里巨省地方",
    "start_time": 11.355,
    "end_time": 12.665,
    "duration": 1.31
  },
  {
    "text": "别看它小",
    "start_time": 12.665,
    "end_time": 13.565,
    "duration": 0.9
  },
  {
    "text": "11万转的风力可不是盖的",
    "start_time": 13.565,
    "end_time": 15.488,
    "duration": 1.922
  },
  {
    "text": "我这长头发",
    "start_time": 15.488,
    "end_time": 16.388,
    "duration": 0.9
  },
  {
    "text": "几分钟就搞定了",
    "start_time": 16.388,
    "end_time": 17.545,
    "duration": 1.157
  },
  {
    "text": "而且它这个屏显调温我真的超爱",
    "start_time": 17.545,
    "end_time": 19.773,
    "duration": 2.228
  },
  {
    "text": "想要什么温度自己调",
    "start_time": 19.773,
    "end_time": 21.236,
    "duration": 1.463
  },
  {
    "text": "清清楚楚",
    "start_time": 21.236,
    "end_time": 22.136,
    "duration": 0.9
  },
  {
    "text": "经常出门的姐妹",
    "start_time": 22.136,
    "end_time": 23.294,
    "duration": 1.157
  },
  {
    "text": "这个颜值高又强悍的小东西",
    "start_time": 23.294,
    "end_time": 25.216,
    "duration": 1.922
  },
  {
    "text": "必须焊在你的行李箱里",
    "start_time": 25.216,
    "end_time": 26.832,
    "duration": 1.616
  }
]