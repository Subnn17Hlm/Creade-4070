[project]
requires = ["python-3.12"]
project_type = "web"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "Creade4070Workflow/scripts/dev-build-minimal.sh"]
run = ["bash", "Creade4070Workflow/scripts/dev-run-minimal.sh"]

[deploy]
build = ["bash", "Creade4070Workflow/scripts/setup.sh"]
run = ["bash", "Creade4070Workflow/scripts/http_run.sh"]

[deploy.profile]
kind = "service"
flavor = "workflow"

[subprojects]
path = ["Creade4070Workflow"]
