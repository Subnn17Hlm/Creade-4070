[project]
requires = ["python-3.12"]
project_type = ""

[preview]
preview_enable = "disabled"

[deploy]
build = ["bash", "Creade4070Workflow/scripts/setup.sh"]
run = ["bash", "Creade4070Workflow/scripts/http_run.sh"]

[deploy.profile]
kind = "service"
flavor = "workflow"

[subprojects]
path = ["Creade4070Workflow"]
